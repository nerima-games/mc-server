{
  "name": "@nerima-games/mc-server",
  "version": "0.0.0",
  "description": "Node host for the Minecraft multiplayer server.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.14.0"
  },
  "packageManager": "pnpm@12.14.0",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./shared": {
      "types": "./dist/apps/multiplayer-shared/index.d.ts",
      "import": "./dist/apps/multiplayer-shared/index.js",
      "default": "./dist/apps/multiplayer-shared/index.js"
    }
  },
  "bin": {
    "mc-server": "./dist/apps/multiplayer-server/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "lint": "oxlint --deny-warnings src apps test scripts && ast-grep scan",
    "lint:fix": "oxlint --fix src apps test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.7.1",
    "@nerima-games/mc-sim": "0.4.2",
    "@nerima-games/mc-worldgen": "0.3.2",
    "@nerima-games/mx-gameplay": "0.6.0",
    "@nerima-games/mx-multiplayer": "0.11.0",
    "@nerima-games/mx-redstone": "0.3.3",
    "effect": "3.22.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "4.1.12",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
