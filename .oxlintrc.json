{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "7.0"
    }
  },
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@nerima-games/mc-host-web",
              "@nerima-games/mc-host-web/**",
              "@nerima-games/mc-playground-kit",
              "@nerima-games/mc-playground-kit/**",
              "@nerima-games/mc-dev-meta",
              "@nerima-games/mc-dev-meta/**"
            ],
            "message": "mc-server may depend on lower tiers, but mc-playground-kit is dev-only and Tier5 peers are forbidden."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/**", "test/**"],
      "rules": {
        "no-magic-numbers": "off",
        "id-length": "off",
        "sort-keys": "off",
        "sort-imports": "off",
        "no-undefined": "off",
        "curly": "off",
        "no-ternary": "off",
        "no-nested-ternary": "off",
        "capitalized-comments": "off",
        "no-underscore-dangle": "off",
        "max-statements": "off",
        "max-params": "off",
        "prefer-destructuring": "off",
        "new-cap": "off",
        "func-names": "off",
        "func-style": "off",
        "arrow-body-style": "off",
        "no-continue": "off",
        "no-await-in-loop": "off",
        "no-use-before-define": "off",
        "init-declarations": "off",
        "no-shadow": "off",
        "complexity": "off",
        "no-void": "off",
        "no-eq-null": "off",
        "no-bitwise": "off",
        "prefer-object-has-own": "off",
        "prefer-named-capture-group": "off",
        "prefer-const": "off",
        "default-case": "off",
        "no-empty-function": "off",
        "no-console": "off",
        "no-control-regex": "off",
        "no-unmodified-loop-condition": "off",
        "no-promise-executor-return": "off",
        "no-unsafe-optional-chaining": "off",
        "no-implicit-coercion": "off",
        "no-loop-func": "off",
        "no-throw-literal": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"]
}
